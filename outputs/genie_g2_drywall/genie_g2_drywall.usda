#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    prepend references = @genie_g2_drywall_task.usd@
)
{
    def Xform "GenieG2" (
        prepend references = @../../third_party/geniesim_assets/robot/G2_omnipicker/robot.usda@
    )
    {
        double3 xformOp:translate = (-2.15, -1.55, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
